# Telegram bot (create with @BotFather)
TELEGRAM_BOT_TOKEN=
# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate locally with: python generate_session.py
TELETHON_SESSION=
# Numeric IDs, usually -100xxxxxxxxxx for channels
STORAGE_CHANNEL_ID=
TARGET_CHANNEL_ID=
# Telegram numeric user ID allowed to use admin commands
ADMIN_USER_ID=

# PeeStream API key from PeeStream Settings
PEESTREAM_API_KEY=
PEESTREAM_API_BASE=https://peestream.com
PEESTREAM_FOLDER_ID=0
# Optional only if PeeStream API info response does not include a public 'link'.
# Must be a verified URL pattern containing {filecode}; do not guess this value.
PEESTREAM_LINK_TEMPLATE=

# Runtime
DATABASE_PATH=./data/jobs.sqlite3
MAX_VIDEO_MB=500
PORT=8000
WORKER_POLL_SECONDS=5
MAX_UPLOAD_ATTEMPTS=5
# Publish at most one successfully uploaded video per interval
PUBLISH_INTERVAL_MINUTES=30

# Pixhost API v2 (no API key required)
PIXHOST_API_BASE=https://api.pixhost.cc
PIXHOST_THUMB_SIZE=420
# Adult previews are automatically classified as NSFW (content_type=1) in code.
